my_data <- read.table("/Users/ilishaanerker/Desktop/STAT 318 /chem.txt", header = TRUE)
library(leaps)
#Testing if any predictors to remove
MLRmodel<-lm(y~.,data=my_data)
summary(MLRmodel)
