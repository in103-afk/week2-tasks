new_data<-subset (my_data, select=-x5)
head(new_data)
newMLR<- lm(y~., data=new_data)
summary(newMLR)
selection_process<-leaps(x=new_data[,-10], y=new_data[,10],int= TRUE, method="Cp")
which.min(selection_process$Cp)
selection_process$which[30,]
n=dim(my_data)
print(n)
n=61
#additive model
lm.additive = lm(y~.,data=new_data)
#Interaction model
lm.interaction= lm(y~.^2, data=new_data)
#Performing stepwise selection with AIC
#step(lm.additive,scope=list(lower=lm.additive, upper=lm.interaction),direction="both",k=2)
#Performing stepwise selection with BIC
#step(lm.additive,scope=list(lower=lm.additive, upper=lm.interaction),direction="both",k=log(n))
#Finding the values of all predictors where y was maximised
max<-which.max(new_data$y)
#Extracting the x values
x_values<-new_data[max,]
print(x_values)
#BIC model
BICfit<-lm(y ~ x1 + x2 + x3 + x4 + x6 + x7 + x8 + x9 + x10 + x4:x10 + x7:x10, data=new_data)
#Interval
confidence_interval<-predict(BICfit, newdata=x_values, interval="confidence", level=0.90)
print(confidence_interval)
